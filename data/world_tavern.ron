(
    spatial: (
        rooms: {
            "secret_chamber": (
                name: "Secret Chamber",
                description: "A hidden chamber untouched for centuries. Dust motes dance in the air, and ancient treasures line the walls. A dark presence permeates the room - something terrible awaits.",
                exits: {"west": (target_room: "ruins", requires: None)},
                objects: ["ancient_scroll", "golden_chalice", "enchanted_amulet"],
                npcs: ["undead_priest"],
                characters: [],
            ),
            "street": (
                name: "Cobblestone Street",
                description: "A quiet street paved with worn cobblestones. The tavern stands behind you, while the bustling market lies to the east. A forest path winds north into the wilderness.",
                exits: {"north": (target_room: "forest_path", requires: None), "in": (target_room: "tavern", requires: None), "east": (target_room: "market", requires: None)},
                objects: [],
                npcs: [],
                characters: ["Grimnar"],
            ),
            "tavern": (
                name: "The Rusty Flagon Tavern",
                description: "A cozy tavern with worn wooden tables and a crackling fireplace. The smell of ale and roasted meat fills the air. A narrow staircase leads down to the cellar, and the front door opens to the street.",
