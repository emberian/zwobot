                objects: ["leather_armor", "fresh_bread", "silver_dagger"],
                npcs: ["merchant"],
                characters: [],
            ),
            "cellar": (
                name: "Tavern Cellar",
                description: "A damp, dimly lit cellar filled with barrels and crates. Cobwebs hang from the ceiling, and you can hear the faint sound of dripping water. A wooden ladder leads back up to the tavern.",
                exits: {"up": (target_room: "tavern", requires: None)},
                objects: ["health_potion", "old_key", "torch"],
                npcs: [],
                characters: ["Pip"],
            ),
            "ruins": (
                name: "Ancient Ruins",
                description: "Crumbling stone walls covered in moss and vines mark what was once a grand structure. Strange symbols are carved into the weathered stones. The air feels cold and wrong here. A heavy stone door to the east is sealed with an intricate lock.",
