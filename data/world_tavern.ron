                objects: ["rusty_sword", "mysterious_map", "bread", "ale"],
                npcs: ["innkeeper"],
                characters: ["Elara"],
            ),
            "forest_path": (
                name: "Forest Path",
                description: "A narrow dirt path winds through dense trees. Sunlight filters through the canopy, creating dappled patterns on the ground. The sounds of birds and rustling leaves surround you. The path continues deeper into the forest to the north.",
                exits: {"north": (target_room: "ruins", requires: None), "south": (target_room: "street", requires: None)},
                objects: ["wooden_staff"],
                npcs: ["hermit"],
                characters: [],
            ),
            "market": (
                name: "Village Market",
                description: "A lively marketplace with colorful stalls selling goods. Merchants call out their wares, and the air is filled with the scent of fresh bread and exotic spices.",
